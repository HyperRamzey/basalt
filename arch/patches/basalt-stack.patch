+            if (dk + dv != 0 || T == 1 || T == MT)
+                std::printf("%s projections T=%d  key %zu  value %zu  differing values%s\n", forms[f].name, T, dk, dv,
+                            dk + dv ? "  DIFF" : "");
+            fail += dk + dv != 0;
+        }
+        // the CPU reference (Q2_0's arithmetic is native_mmvq_parity's)
