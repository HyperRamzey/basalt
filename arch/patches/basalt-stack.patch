+                    sum_old += s.per_chunk * to;
+                }
+                std::printf("T %6lld per chunk, 48 layers: Gemm %.2f ms, cublasGemmEx %.2f ms (%+.2f%%)\n", (long long) T,
+                            sum_new / 1e3, sum_old / 1e3, 100.0 * (sum_new / sum_old - 1.0));
