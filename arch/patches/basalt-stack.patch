+                              "%.2f GiB free, %.2f GiB kept free", (long long) cells,
+                              (double) ((uint64_t) cells * in.bytes_per_cell) / 1073741824.0,
+                              (double) in.ram_available / 1073741824.0, (double) in.ram_kept / 1073741824.0);
+        return 1;
+    case basalt::program::KvHostAct::keep:
