+    def test_truncated_shard_fails_during_streaming(self):
+        from multiprocessing.dummy import Pool
+        with tempfile.TemporaryDirectory() as tmp:
+            d = Path(tmp)
+            self.build(d, [("shard_0.weight", 1)])
+            ple = C.ple_table(self.ck(d))
