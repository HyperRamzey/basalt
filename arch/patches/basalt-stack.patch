+    CHECK(c::qsa_kv_host_layer_bytes(st, g, 1001) == 251ull * 4224 + 1024);
+    uint8_t* const base = reinterpret_cast<uint8_t*>(uint64_t{1} << 20);   // never dereferenced
+    const k::KvHostPools h = c::qsa_kv_host_carve(st, g, base, 1000);
+    const uint64_t rows = 250ull * g.n_head_kv * 4;
+    CHECK((uint8_t*) h.k_q == base);
+    CHECK((uint8_t*) h.v_q == base + rows * g.head_dim);
+    CHECK((uint8_t*) h.k_scale == base + 2 * rows * g.head_dim);
+    CHECK((uint8_t*) h.v_scale == base + 2 * rows * g.head_dim + rows * (g.head_dim / 64) * 2);
+    CHECK((uint8_t*) h.v_scale + rows * (g.head_dim / 64) * 2 <= base + c::qsa_kv_host_layer_bytes(st, g, 1000));
+    CHECK(h.present() && h.k_pool == nullptr && h.k_q4 == nullptr);
+    // Q4_0 and FP16: two arrays each
+    c::QsaState q4;
+    q4.kv_q4 = true;
+    const k::KvHostPools hq = c::qsa_kv_host_carve(q4, g, base, 1000);
+    CHECK(hq.k_q4 == base && hq.v_q4 == base + rows * k::kv_q4_bytes_per_head((int) g.head_dim) && hq.k_q == nullptr);
+    c::QsaState f16;
+    const k::KvHostPools hf = c::qsa_kv_host_carve(f16, g, base, 1000);
+    CHECK((uint8_t*) hf.k_pool == base && (uint8_t*) hf.v_pool == base + rows * g.head_dim * 2);
+    CHECK(c::qsa_kv_host_layer_bytes(f16, g, 1000) == 250ull * k::kv_block_bytes(k::qsa_real_shapes(), k::kKvF16) + 1024);
+    // a session's pool: one 256-aligned copy per allocated QSA layer
+    c::QsaState layers[12];
+    for (c::QsaState& x : layers) x.kv_int8 = true;
+    c::SessionState ss;
+    ss.qsa_states = layers;
+    ss.qsa_ord0 = 0;
+    ss.qsa_alloc = 12;
+    const uint64_t per = (c::qsa_kv_host_layer_bytes(layers[0], g, 131072) + 255) & ~255ull;
+    CHECK(c::KvHostPool::bytes_for(ss, g, 131072) == 12 * per);
+    CHECK(c::KvHostPool::bytes_for(ss, g, 131072) > 131072ull * 12 * 1056);   // 1,056 B per cell and layer, plus slack
+    // the switch refuses, before any device work, a state that cannot stream and a mode-1 switch without a host copy
+    std::string err;
+    CHECK(!c::session_kv_can_stream(ss));
+    CHECK(!c::session_kv_set_mode(ss, g, 1, nullptr, 0, nullptr, err) && !err.empty());
+    err.clear();
+    CHECK(!c::qsa_state_set_mode(layers[0], g, 1, k::KvHostPools{}, 0, 0, nullptr, err) && !err.empty());
+    CHECK(c::session_kv_mode(ss) == 0);
+    layers[3].kv_mode = 1;
+    CHECK(c::session_kv_mode(ss) == -1);
+    if (g_fail) { std::printf("kv_host_layout_test: %d failures\n", g_fail); return 1; }
+    std::printf("kv_host_layout_test: ok\n");
+    return 0;
+}
diff --git a/tests/core/kv_mode_switch_test.cpp b/tests/core/kv_mode_switch_test.cpp
new file mode 100644
index 00000000..32f6fe33
--- /dev/null
+++ b/tests/core/kv_mode_switch_test.cpp
@@ -0,0 +1,305 @@
+// tests/core/kv_mode_switch_test.cpp - one elastic QSA state switched between whole-in-VRAM and streamed in place
+// (qsa_state_set_mode, kv_host_pool.hpp), against a plain whole-in-VRAM state fed the same cells (GPU, no model).
+//
+// A synthetic sequence is appended to both.  The elastic state starts in mode 0, switches to mode 1 at a depth (a host
+// pool for the request's cells), moves to a larger host pool, switches back to mode 0, and streams once more.  Every
+// few cells a batch of 1-8 queries is attended in both (kv_stream_resolve before the streamed attention).  Checks:
+//   1. the attention outputs are BITWISE equal in every phase;
+//   2. while streamed, the K/V arrays stay at the slot pool's pages (the depth follows only in the pooled keys);
+//   3. after the switch back, the VRAM K/V of every live cell equals the reference's;
+//   4. a conversation snapshot taken in mode 1 equals one taken in mode 0 at the same depth, and restores into mode 1.
+// INT8, FP16 and Q4_0, with the elastic floor at the slot pool and below it.  Exits 77 without a CUDA device or virtual
+// memory management.
+#include "basalt/core/conversation_snapshot.hpp"
+#include "basalt/core/kv_arena.hpp"
+#include "basalt/core/kv_host_pool.hpp"
+#include "basalt/core/layer.hpp"
+#include "basalt/core/session.hpp"
+#include "basalt/core/vmm.hpp"
+#include "basalt/kernels/kv_q4.hpp"
+#include "basalt/kernels/kv_q8.hpp"
+#include "basalt/kernels/kv_stream.hpp"
+#include "basalt/kernels/qsa.hpp"
+#include "basalt/kernels/qsa_decode_attn.hpp"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace k = basalt::kernels;
+namespace c = basalt::core;
+
+namespace {
+void ck(cudaError_t e, const char* w) {
+    if (e != cudaSuccess) { std::fprintf(stderr, "%s: %s\n", w, cudaGetErrorString(e)); std::exit(2); }
+}
+template <typename T> T* dalloc(size_t n) {
+    T* p = nullptr;
+    ck(cudaMalloc(&p, n * sizeof(T) + 64), "malloc");
+    ck(cudaMemset(p, 0, n * sizeof(T) + 64), "memset");
+    return p;
+}
+
+// as kv_stream_parity: ascending cells, whole blocks, the tail block, one partial block
+std::vector<int32_t> selection(int64_t n_kv, int64_t width, std::mt19937& rng) {
+    std::vector<int32_t> ids;
+    if (n_kv <= width) {
+        for (int64_t i = 0; i < n_kv; ++i) ids.push_back((int32_t) i);
+        return ids;
+    }
+    const int64_t n_bid = n_kv / 4, tail = n_kv - n_bid * 4;
+    std::set<int64_t> blocks;
+    const int64_t want_full = (width - tail) / 4, part = (width - tail) % 4;
+    std::uniform_int_distribution<int64_t> any(0, n_bid - 1), recent(std::max<int64_t>(0, n_bid - 2048), n_bid - 1);
+    while ((int64_t) blocks.size() < want_full + (part ? 1 : 0)) blocks.insert(rng() % 2 ? recent(rng) : any(rng));
+    const int64_t partial = part ? *std::next(blocks.begin(), (long) (rng() % blocks.size())) : -1;
+    for (int64_t b : blocks)
+        for (int64_t i = 0; i < (b == partial ? part : 4); ++i) ids.push_back((int32_t) (b * 4 + i));
+    for (int64_t i = n_bid * 4; i < n_kv; ++i) ids.push_back((int32_t) i);
+    std::sort(ids.begin(), ids.end());
+    return ids;
+}
+
+void append(const c::QsaState& st, const int32_t* step, const float* kc, const float* vc, const k::QsaShapes& s) {
+    const k::KvHostPools* host = st.host.present() ? &st.host : nullptr;
+    if (st.kv_q4) k::kv_append_q4_step(st.k_q4, st.v_q4, st.page_table, step, kc, vc, s, nullptr, host);
+    else if (st.kv_int8) k::kv_append_q8_step(st.k_q, st.v_q, st.k_scale, st.v_scale, st.page_table, step, kc, vc, s, nullptr, host);
+    else k::kv_append_step(st.k_pool, st.v_pool, st.page_table, step, kc, vc, s, nullptr, host);
+}
+
+bool same_device(const void* a, const void* b, size_t n) {
+    std::vector<uint8_t> x(n), y(n);
+    ck(cudaMemcpy(x.data(), a, n, cudaMemcpyDefault), "cmp a");
+    ck(cudaMemcpy(y.data(), b, n, cudaMemcpyDefault), "cmp b");
+    return std::memcmp(x.data(), y.data(), n) == 0;
+}
+
+int run(int fmt, int64_t floor) {
+    const char* name = fmt == k::kKvQ4 ? "q4_0" : fmt == k::kKvInt8 ? "int8" : "fp16";
+    std::printf("  %s, elastic floor %lld cells:\n", name, (long long) floor);
+    c::qsa_set_kv_int8(fmt == k::kKvInt8);
+    c::qsa_set_kv_q4(fmt == k::kKvQ4);
+    const c::ModelGeometry g{};
+    k::QsaShapes s = k::qsa_real_shapes();
+    s.n_head = g.n_head; s.n_head_kv = g.n_head_kv; s.head_dim = g.head_dim; s.idx_n_head = g.idx_q_heads;
+    s.idx_dim = g.idx_key_dim;
+    const int64_t max_cells = 65536, slot = 32768, N = 60000, switch_at = 20000, grow_at = 36000, back_at = 48000;
+    // the plain reference: whole in VRAM, identity table
+    c::qsa_set_kv_elastic(0);
+    c::qsa_set_kv_host(0);
+    c::QsaState ref;
+    void* rb = dalloc<uint8_t>(c::qsa_state_bytes(g, max_cells));
+    if (c::qsa_state_init(g, max_cells, rb, ref) == 0) { std::fprintf(stderr, "reference init failed\n"); return 1; }
+    // the switchable state: elastic, a slot pool of `slot` cells
+    c::qsa_set_kv_elastic(floor);
+    c::qsa_set_kv_host(slot);
+    c::QsaState st;
+    void* sb = dalloc<uint8_t>(c::qsa_state_bytes(g, max_cells));
+    const uint64_t used = c::qsa_state_init(g, max_cells, sb, st);
+    c::qsa_set_kv_elastic(0);
+    c::qsa_set_kv_host(0);
+    if (used == 0 || st.kv_arena == nullptr || st.host_slots != slot / s.page_size) {
+        std::fprintf(stderr, "%s: switchable init failed (arena %p, host slots %lld)\n", name, (void*) st.kv_arena,
+                     (long long) st.host_slots);
+        return 1;
+    }
+    c::SessionState ss;   // a one-layer session over the state, for the host pool
+    ss.qsa_states = &st;
+    ss.qsa_ord0 = 0;
+    ss.qsa_alloc = 1;
+    c::qsa_state_zero(ref, g, nullptr);
+    c::qsa_state_zero(st, g, nullptr);
+
+    const int64_t cap = k::qsa_selection_width(k::kTopkMaxCells, s), NQ = 8;
+    const int64_t H = s.n_head_kv, D = s.head_dim, NH = s.n_head;
+    std::mt19937 rng(11 + 5 * fmt);
+    std::normal_distribution<float> nd(0.f, 1.f);
+    float* kc = dalloc<float>(H * D);
+    float* vc = dalloc<float>(H * D);
+    int32_t* step = dalloc<int32_t>(k::kStepCount);
+    int32_t* steps = dalloc<int32_t>(NQ * k::kStepCount);
+    int32_t* ids = dalloc<int32_t>(NQ * cap);
+    float* q = dalloc<float>(NQ * NH * D);
+    float* scratch = dalloc<float>(NQ * k::qsa_decode_attn_scratch_floats(cap, s));
+    float* out_ref = dalloc<float>(NQ * NH * D);
+    float* out_st = dalloc<float>(NQ * NH * D);
+    std::vector<float> hk(H * D), hv(H * D), hq(NQ * NH * D), a((size_t) NQ * NH * D), b((size_t) NQ * NH * D);
+    c::KvHostPool pool, pool2;
+    std::string err;
+    int bad = 0, batches = 0;
+    k::KvStreamCounters cn{};   // the streamed phase's, read before the switch back frees the residency map
+    const uint64_t page_kv = k::kv_block_bytes(s, fmt);
+
+    for (int64_t pos = 0; pos < N; ++pos) {
+        if (pos == switch_at) {   // 0 -> 1: the slot pages backed, a host pool for the request's cells, the VRAM K/V past
+                                  // the slots given back
+            if (!st.kv_arena->map(slot, err) || !pool.reserve(ss, g, grow_at + 64, err) ||
+                !c::session_kv_set_mode(ss, g, 1, &pool, pos, nullptr, err) || !st.kv_arena->unmap(slot, err)) {
+                std::fprintf(stderr, "%s: switch to 1 at %lld: %s\n", name, (long long) pos, err.c_str());
+                return 1;
+            }
+            std::printf("  %s: streamed at %lld cells, %.1f MiB host, %.1f MiB VRAM arena\n", name, (long long) pos,
+                        (double) pool.bytes() / 1048576.0, (double) st.kv_arena->mapped_bytes() / 1048576.0);
+            if (st.host_map == nullptr || st.map.slot_block == nullptr) {
+                std::fprintf(stderr, "  %s: streamed without a residency map\n", name);
+                ++bad;
+            }
+        }
+        // a parked conversation deeper than the pool held: valid for the state (admission grows the pool before the
+        // restore), restored only once the pool holds it
+        c::ConversationKv deep;
+        const int64_t deep_upto = pos == grow_at ? pool.cells() + 1024 : 0;
+        bool deep_early = false;
+        if (pos == grow_at) {
+            std::string verr, rerr;
+            if (!st.kv_arena->map(deep_upto + 4096, err) || !c::conversation_kv_save(deep, ref, g, deep_upto, true, err)) {
+                std::fprintf(stderr, "%s: deep snapshot: %s\n", name, err.c_str());
+                return 1;
+            }
+            const bool valid = c::conversation_kv_validate(deep, st, g, deep_upto, true, verr);
+            deep_early = c::conversation_kv_restore(deep, st, g, deep_upto, true, rerr);
+            std::printf("  %s: a %lld-cell snapshot beside a %lld-cell pool: validate %s, restore %s\n", name,
+                        (long long) deep_upto, (long long) pool.cells(), valid ? "ok" : verr.c_str(),
+                        deep_early ? "ran (wrong)" : rerr.c_str());
+            if (!valid || deep_early || rerr.find("host pool") == std::string::npos) ++bad;
+        }
+        if (pos == grow_at) {   // 1 -> 1: a larger pool, the cells moved over in host memory
+            if (!pool2.reserve(ss, g, N + 64, err) || !pool2.copy_from(pool, pos, err) ||
+                !c::session_kv_set_mode(ss, g, 1, &pool2, pos, nullptr, err)) {
+                std::fprintf(stderr, "%s: pool move at %lld: %s\n", name, (long long) pos, err.c_str());
+                return 1;
+            }
+            pool.release();
+            // the pool now holds the deep snapshot (its cells past `pos` are rewritten as the run goes on)
+            if (!c::conversation_kv_restore(deep, st, g, deep_upto, true, err)) {
+                std::fprintf(stderr, "  %s: deep snapshot restore after the pool grew: %s\n", name, err.c_str());
+                ++bad;
+            }
+        }
+        if (pos == back_at) {   // 1 -> 0: uncap, back the depth, copy the cells in
+            cn = k::kv_stream_counters(st.map);
+            c::session_kv_cap(ss, false);
+            if (!st.kv_arena->map(pos + 4096, err) || !c::session_kv_set_mode(ss, g, 0, nullptr, pos, nullptr, err)) {
+                std::fprintf(stderr, "%s: switch to 0 at %lld: %s\n", name, (long long) pos, err.c_str());
+                return 1;
+            }
+            // every live cell's VRAM K/V equals the reference's (whole pages, arrays in carve order)
+            const k::QsaAttnPools x = c::qsa_attn_pools(st), y = c::qsa_attn_pools(ref);
+            const size_t live = (size_t) (pos / s.page_size);
+            const size_t rows = live * s.n_head_kv * s.page_size;
+            bool eq = true;
+            if (fmt == k::kKvQ4) {
+                const size_t n = rows * k::kv_q4_bytes_per_head((int) D);
+                eq = same_device(x.k_q4, y.k_q4, n) && same_device(x.v_q4, y.v_q4, n);
+            } else if (fmt == k::kKvInt8) {
+                eq = same_device(x.k_q, y.k_q, rows * D) && same_device(x.v_q, y.v_q, rows * D) &&
+                     same_device(x.k_scale, y.k_scale, rows * (D / 64) * 2) && same_device(x.v_scale, y.v_scale, rows * (D / 64) * 2);
+            } else {
+                eq = same_device(x.k_pool, y.k_pool, rows * D * 2) && same_device(x.v_pool, y.v_pool, rows * D * 2);
+            }
+            std::printf("  %s: back in VRAM at %lld cells: K/V %s\n", name, (long long) pos, eq ? "identical" : "DIFFERS");
+            if (!eq) ++bad;
+            if (st.host_map != nullptr || st.map.slot_block != nullptr) {
+                std::fprintf(stderr, "  %s: the residency map outlived the switch back\n", name);
+                ++bad;
+            }
+            pool2.release();
+        }
+        // the arena follows the depth as the engine's kv_fit does (in mode 1 only the pooled keys and rope grow)
+        if (st.kv_arena->cells() < pos + 1 && !st.kv_arena->map(pos + 4096, err)) {
+            std::fprintf(stderr, "%s: map at %lld: %s\n", name, (long long) pos, err.c_str());
+            return 1;
+        }
+        if (st.kv_mode == 1) {
+            // 2. streamed: the K/V arrays hold the slot pool's pages; only the pooled keys and the rope rows follow
+            const uint64_t depth = (uint64_t) st.kv_arena->cells();
+            const uint64_t bound = (uint64_t) st.host_slots * page_kv + (depth / s.idx_block + 2) * s.idx_dim * 4 +
+                                   depth * (s.n_rot / 2) * 4 * 2 + 8 * c::vmm::granularity();
+            if (st.kv_arena->mapped_bytes() > bound && bad++ < 5)
+                std::fprintf(stderr, "  %s: streamed arena %.1f MiB at %lld cells, more than %.1f\n", name,
+                             (double) st.kv_arena->mapped_bytes() / 1048576.0, (long long) pos, (double) bound / 1048576.0);
+        }
+        for (auto& x : hk) x = nd(rng) * ((pos % 17 == 0) ? 30.f : 1.f);
+        for (auto& x : hv) x = nd(rng);
+        const int32_t sv[4] = {(int32_t) pos, (int32_t) (pos + 1), (int32_t) ((pos + 1) / 4), 0};
+        ck(cudaMemcpy(kc, hk.data(), hk.size() * 4, cudaMemcpyHostToDevice), "k");
+        ck(cudaMemcpy(vc, hv.data(), hv.size() * 4, cudaMemcpyHostToDevice), "v");
+        ck(cudaMemcpy(step, sv, sizeof(sv), cudaMemcpyHostToDevice), "step");
+        append(ref, step, kc, vc, s);
+        append(st, step, kc, vc, s);
+        if (pos % 211 != 210 && pos != N - 1 && pos != switch_at && pos != back_at) continue;
+        const int n_q = 1 + (int) (rng() % NQ);
+        std::vector<int32_t> hids((size_t) NQ * cap, 0), hst(NQ * 4, 0);
+        for (int t = 0; t < n_q; ++t) {
+            const int64_t p = std::max<int64_t>(0, pos - (n_q - 1 - t)), n_kv = p + 1;
+            const int64_t width = std::min<int64_t>(n_kv, cap);
+            const std::vector<int32_t> sel = selection(n_kv, width, rng);
+            std::copy(sel.begin(), sel.end(), hids.begin() + (size_t) t * cap);
+            hst[t * 4 + 0] = (int32_t) p; hst[t * 4 + 1] = (int32_t) n_kv; hst[t * 4 + 2] = (int32_t) (n_kv / 4);
+            hst[t * 4 + 3] = (int32_t) width;
+        }
+        for (auto& x : hq) x = nd(rng);
+        ck(cudaMemcpy(ids, hids.data(), hids.size() * 4, cudaMemcpyHostToDevice), "ids");
+        ck(cudaMemcpy(steps, hst.data(), hst.size() * 4, cudaMemcpyHostToDevice), "steps");
+        ck(cudaMemcpy(q, hq.data(), hq.size() * 4, cudaMemcpyHostToDevice), "q");
+        k::qsa_decode_attn_batch(q, c::qsa_attn_pools(ref), ids, steps, cap, s, scratch, out_ref, n_q, nullptr);
+        c::qsa_kv_resolve(st, g, ids, steps, n_q, cap, nullptr);   // a no-op in mode 0
+        k::qsa_decode_attn_batch(q, c::qsa_attn_pools(st), ids, steps, cap, s, scratch, out_st, n_q, nullptr);
+        ck(cudaDeviceSynchronize(), "batch");
+        ck(cudaMemcpy(a.data(), out_ref, (size_t) n_q * NH * D * 4, cudaMemcpyDeviceToHost), "a");
+        ck(cudaMemcpy(b.data(), out_st, (size_t) n_q * NH * D * 4, cudaMemcpyDeviceToHost), "b");
+        if (std::memcmp(a.data(), b.data(), (size_t) n_q * NH * D * 4) != 0 && bad++ < 5)
+            std::fprintf(stderr, "  %s pos %lld mode %d n_q %d: attention differs\n", name, (long long) pos, st.kv_mode, n_q);
+        ++batches;
+        // 4. at the first streamed batch: a snapshot in mode 1 equals the mode-0 reference's, and restores
+        if (pos == switch_at) {
+            c::ConversationKv x, y;
+            if (!c::conversation_kv_save(x, st, g, pos + 1, true, err) ||
+                !c::conversation_kv_save(y, ref, g, pos + 1, true, err)) {
+                std::fprintf(stderr, "%s: snapshot: %s\n", name, err.c_str());
+                return 1;
+            }
+            const bool same = x.k == y.k && x.v == y.v && x.k_scale == y.k_scale && x.v_scale == y.v_scale &&
+                              x.pooled == y.pooled && x.format == y.format && x.cells == y.cells;
+            const bool back = c::conversation_kv_restore(y, st, g, pos + 1, true, err);
+            std::printf("  %s: snapshot mode 1 vs mode 0 %s, restore into mode 1 %s\n", name,
+                        same ? "identical" : "DIFFERS", back ? "ok" : err.c_str());
+            if (!same || !back) ++bad;
+        }
+    }
+    std::printf("  %s: %d batches, %llu lookups, %llu misses, overflow %d, %d failures\n", name, batches,
+                (unsigned long long) cn.lookups, (unsigned long long) cn.misses, (int) cn.overflow, bad);
+    if (cn.overflow || cn.misses == 0) ++bad;
+    // the state zeroes in either mode (a streamed one only its slot pages)
+    std::string ignored;
+    if (!pool.reserve(ss, g, 4096, err) || !c::session_kv_set_mode(ss, g, 1, &pool, 0, nullptr, err)) {
+        std::fprintf(stderr, "%s: final switch: %s\n", name, err.c_str());
+        return 1;
+    }
+    c::qsa_state_zero(st, g, nullptr);
+    ck(cudaDeviceSynchronize(), "zero streamed");
+    (void) c::session_kv_set_mode(ss, g, 0, nullptr, 0, nullptr, ignored);
+    pool.release();
+    c::qsa_state_release(st);
+    return bad;
+}
+}  // namespace
+
+int main() {
+    int n = 0;
+    if (cudaGetDeviceCount(&n) != cudaSuccess || n == 0) { std::puts("no CUDA device: skipped"); return 77; }
+    if (!c::vmm::supported()) { std::puts("no virtual memory management: skipped"); return 77; }
+    std::printf("kv_mode_switch_test: one elastic state, mode 0 -> 1 -> 1 (larger pool) -> 0 -> 1, vs a resident state\n");
+    int bad = 0;
+    for (int64_t floor : {32768, 8192})
+        for (int fmt : {k::kKvInt8, k::kKvF16, k::kKvQ4}) bad += run(fmt, floor);
+    std::printf(bad ? "FAIL\n" : "PASS\n");
+    return bad ? 1 : 0;
+}
diff --git a/tests/core/ple_ram_quant_test.cpp b/tests/core/ple_ram_quant_test.cpp
new file mode 100644
index 00000000..3ec73b65
--- /dev/null
+++ b/tests/core/ple_ram_quant_test.cpp
@@ -0,0 +1,379 @@
+// tests/core/ple_ram_quant_test.cpp - background/demand conversion and owned-table lifetime.
+#include "gguf_fixture.hpp"
+
+#include "basalt/artifact/dequant.hpp"
+#include "basalt/ggml/ggml.h"
+#include "basalt/kernels/ngram.hpp"
+#include "basalt/ngram/ple_ram_quant.hpp"
+
+#include <algorithm>
+#include <array>
+#include <barrier>
+#include <bit>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+namespace fs = std::filesystem;
+using basalt::kernels::PleIo;
+using basalt::kernels::PleIoOptions;
+using basalt::kernels::PleTable;
+using basalt::ngram::open_ple_q8_0;
+
+namespace {
+constexpr uint32_t kRows = 1031;
+constexpr size_t kCols = 160, kQ8Bytes = 170, kBf16Bytes = 320;
+constexpr size_t kHeads = 16;
+
+void require(bool ok, const std::string& what) {
+    if (!ok) throw std::runtime_error(what);
+}
+
+std::string utf8(const fs::path& path) {
+    const auto text = path.u8string();
+    return std::string(reinterpret_cast<const char*>(text.data()), text.size());
+}
+
+struct TempDir {
+    fs::path path;
+    TempDir() {
+        const auto stamp = std::chrono::steady_clock::now().time_since_epoch().count();
+        for (unsigned attempt = 0; attempt != 100; ++attempt) {
+            const fs::path candidate = fs::temp_directory_path() /
+                ("basalt-ple-ram-quant-" + std::to_string(stamp) + "-" + std::to_string(attempt));
+            if (fs::create_directory(candidate)) { path = candidate; return; }
+        }
+        throw std::runtime_error("cannot create isolated temporary directory");
+    }
+    ~TempDir() {
+        std::error_code ignored;
+        fs::remove_all(path, ignored);
+    }
+};
+
+// All values are exactly BF16-representable. Each row has a different signed pattern, including
+// both halves, so treating a BF16 row as 160 bytes cannot accidentally reproduce its oracle.
+float expected_value(uint32_t row, size_t col) {
+    const size_t block = col / 32, j = col % 32;
+    if (row == 0 && block == 0) return 0.0f;
+    constexpr int exponents[] = {-20, -8, 0, 8, 14};
+    const float scale = std::ldexp(1.0f, exponents[(row + block) % 5]);
+    if (j == 0) return 127.0f * scale;
+    if (j == 1) return -127.0f * scale;
+    if (j == 2) return 0.5f * scale;
+    if (j == 3) return -0.5f * scale;
+    if (j == 4) return 0.0f;
+    uint32_t mixed = row * 0x9e3779b9u + static_cast<uint32_t>(col) * 0x85ebca6bu;
+    mixed ^= mixed >> 16;
+    mixed *= 0x7feb352du;
+    mixed ^= mixed >> 15;
+    return static_cast<float>(static_cast<int>(mixed % 253) - 126) * scale;
+}
+
+struct Oracle {
+    std::vector<float> bf16 = std::vector<float>(kRows * kCols);
+    std::vector<uint8_t> source = std::vector<uint8_t>(kRows * kBf16Bytes);
+    std::vector<uint8_t> packed = std::vector<uint8_t>(kRows * kQ8Bytes);
+
+    Oracle() {
+        const auto* traits = ggml_get_type_traits(GGML_TYPE_Q8_0);
+        require(traits && traits->from_float_ref, "Q8_0 CPU reference encoder unavailable");
+        for (uint32_t row = 0; row < kRows; ++row) {
+            for (size_t col = 0; col < kCols; ++col) {
+                const float value = expected_value(row, col);
+                const uint32_t bits = std::bit_cast<uint32_t>(value);
+                require((bits & 0xffffu) == 0, "fixture value is not exact BF16");
+                bf16[row * kCols + col] = value;
+                const uint16_t word = static_cast<uint16_t>(bits >> 16);
+                std::memcpy(source.data() + row * kBf16Bytes + col * 2, &word, sizeof word);
+            }
+            // Independent of source reads, offsets, chunking and BF16 widening: the ordinary model-file
+            // encoder sees the expected row directly. This tests the loader, not a second quantizer.
+            traits->from_float_ref(bf16.data() + row * kCols, packed.data() + row * kQ8Bytes, kCols);
+        }
+    }
+};
+
+uint64_t write_table(const fs::path& path, uint32_t type, const std::vector<uint8_t>& payload) {
+    const auto written = fixture::write(path, {}, {
+        {"prefix.weight", {8}, 0, 93},
+        {"per_layer_token_embd.weight", {kCols, kRows}, type, 71},
+    });
+    const uint64_t offset = written.data_start + written.offsets[1];
+    require(written.offsets[1] != 0 && offset % 4096 != 0,
+            "fixture must have a nonzero tensor offset unaligned to direct-I/O pages");
+    require(written.size % 4096 != 0, "fixture must end in a partial page");
+    std::fstream file(path, std::ios::binary | std::ios::in | std::ios::out);
+    file.seekp(static_cast<std::streamoff>(offset));
+    file.write(reinterpret_cast<const char*>(payload.data()), static_cast<std::streamsize>(payload.size()));
+    require(static_cast<bool>(file), "cannot populate GGUF fixture payload");
+    return offset;
+}
+
+void compare_packed(const basalt::ngram::LockedPleBuffer& buffer, const Oracle& oracle,
+                    const std::vector<float>& decoded, const std::string& label) {
+    // Large pages are inherently resident; their explicit locked_bytes count is zero.
+    require(buffer.data && buffer.mapping && buffer.mapping_bytes >= oracle.packed.size() &&
+            (buffer.locked_bytes == 0 || buffer.locked_bytes >= oracle.packed.size()),
+            label + ": output must own the full resident allocation");
+    const auto* bytes = static_cast<const uint8_t*>(buffer.data);
+    size_t bad_bytes = 0, bad_values = 0;
+    float max_error = 0.0f;
+    std::array<float, kCols> row_values{};
+    for (uint32_t row = 0; row < kRows; ++row) {
+        for (size_t b = 0; b < kQ8Bytes; ++b)
+            bad_bytes += bytes[row * kQ8Bytes + b] != oracle.packed[row * kQ8Bytes + b];
+        for (size_t block = 0; block < kCols / 32; ++block)
+            basalt::dequantize_q8_0(bytes + row * kQ8Bytes + block * 34, row_values.data() + block * 32);
+        for (size_t col = 0; col < kCols; ++col) {
+            const float expected = decoded[row * kCols + col];
+            bad_values += row_values[col] != expected;
+            max_error = std::max(max_error, std::abs(row_values[col] - expected));
+        }
+    }
+    std::printf("  %s: %u rows, %zu packed bytes, %zu decoded values; mismatches %zu/%zu, max error %.9g\n",
+                label.c_str(), kRows, oracle.packed.size(), decoded.size(), bad_bytes, bad_values,
+                static_cast<double>(max_error));
+    require(bad_bytes == 0 && bad_values == 0, label + ": differs from CPU model-file Q8_0 oracle");
+}
+
+void exercise_partial(basalt::ngram::LockedPleBuffer& buffer, const Oracle& oracle) {
+    std::array<int, 4> ok{1, 1, 1, 1};
+    std::barrier start((ptrdiff_t) ok.size());
+    std::vector<std::thread> readers;
+    for (size_t worker = 0; worker < ok.size(); ++worker) readers.emplace_back([&, worker] {
+        std::string err;
+        start.arrive_and_wait();
+        // Competing readers visit the tail first, cross every 128-row region boundary, and repeat rows.
+        for (uint32_t i = 0; i < 2 * kRows; ++i) {
+            const uint32_t row = kRows - 1 - ((i + (uint32_t) worker * 127) % kRows);
+            if (!buffer.ensure_row(row, err) ||
+                std::memcmp(buffer.data + row * kQ8Bytes, oracle.packed.data() + row * kQ8Bytes, kQ8Bytes) != 0)
+                ok[worker] = 0;
+        }
+    });
+    for (auto& thread : readers) thread.join();
+    require(std::all_of(ok.begin(), ok.end(), [](int value) { return value != 0; }),
+            "foreground/background ownership must preserve exact Q8 bytes for all concurrent readers");
+    std::string err;
+    require(!buffer.ensure_row(kRows, err) && !err.empty(), "ensure must reject invalid rows");
+    require(buffer.ensure_row(kRows - 1, err), "invalid demand must not poison valid rows");
+    require(buffer.wait(err), "background completion: " + err);
+    require(buffer.wait(err), "completion wait must be repeatable: " + err);
+}
+
+void compare_all_rows(const PleTable& table, const std::vector<float>& expected, const std::string& label) {
+    std::array<float, kCols> row_values{};
+    size_t bad = 0;
+    for (uint32_t row = 0; row < kRows; ++row) {
+        table.read_row(row, row_values.data());
+        for (size_t col = 0; col < kCols; ++col) bad += row_values[col] != expected[row * kCols + col];
+    }
+    std::printf("  %s: %u rows / %zu values, %zu mismatches\n", label.c_str(), kRows, expected.size(), bad);
+    require(bad == 0, label + ": row mismatch");
+}
+
+std::array<uint32_t, 3 * kHeads> batch_indices() {
+    constexpr uint32_t boundaries[] = {0, 1, 12, 13, 126, 127, 128, 508, 509, 510, 1015, 1016, 1017, 1018, 1029, 1030};
+    std::array<uint32_t, 3 * kHeads> rows{};
+    for (size_t i = 0; i < rows.size(); ++i) rows[i] = boundaries[(i * 7 + i / kHeads) % kHeads];
+    rows[17] = rows[16]; // duplicate rows must preserve output placement, not disappear during dedupe
+    return rows;
+}
+
+bool rows_equal(const float* values, const uint32_t* rows, size_t count, const std::vector<float>& expected) {
+    for (size_t i = 0; i < count; ++i)
+        for (size_t col = 0; col < kCols; ++col)
+            if (values[i * kCols + col] != expected[rows[i] * kCols + col]) return false;
+    return true;
+}
+
+void exercise_apis(PleTable& table, const std::vector<float>& expected) {
+    const auto rows = batch_indices();
+    std::vector<float> out(rows.size() * kCols, -999.0f);
+    std::string err;
+    table.gather(rows.data(), out.data());
+    require(rows_equal(out.data(), rows.data(), kHeads, expected), "gather ordering/parity");
+    require(!table.collect(out.data(), err), "collect without issue must fail");
+    require(table.issue(rows.data()), "issue converted rows");
+    require(!table.gather_batch(rows.data(), 3, out.data(), err), "batch must not consume pending decode slot");
+
+    // The independent prompt API must not overwrite the pending token, even with simultaneous readers.
+    std::array<int, 3> thread_ok{1, 1, 1};
+    std::vector<std::thread> readers;
+    for (size_t worker = 0; worker < thread_ok.size(); ++worker) {
+        readers.emplace_back([&, worker] {
+            std::vector<float> values(rows.size() * kCols);
+            std::string error;
+            for (int generation = 0; generation < 4; ++generation) {
+                if (!table.gather_rows(rows.data(), 3, values.data(), error) ||
+                    !rows_equal(values.data(), rows.data(), rows.size(), expected)) thread_ok[worker] = 0;
+            }
+        });
+    }
+    for (auto& reader : readers) reader.join();
+    require(std::all_of(thread_ok.begin(), thread_ok.end(), [](int ok) { return ok != 0; }),
+            "concurrent gather_rows must preserve every prompt row");
+    require(table.collect(out.data(), err) && rows_equal(out.data(), rows.data(), kHeads, expected),
+            "collect must retain original token across concurrent prompt reads");
+    require(!table.collect(out.data(), err), "collected ticket cannot be collected twice");
+    require(table.gather_batch(rows.data(), 3, out.data(), err) &&
+            rows_equal(out.data(), rows.data(), rows.size(), expected), "batch duplicates/order/tail parity");
+    table.prefetch_rows(rows.data());
+    table.wait_prefetches();
+    require(table.warm_rows(rows.data(), 3, err), "warm converted rows");
+    require(table.gather_rows(rows.data(), 3, out.data(), err) &&
+            rows_equal(out.data(), rows.data(), rows.size(), expected), "prefetch/warm must preserve owned table");
+    require(table.gather_batch(rows.data(), 0, out.data(), err), "empty batch succeeds");
+    for (uint32_t invalid : {kRows, std::numeric_limits<uint32_t>::max()}) {
+        std::array<float, kCols> missing;
+        missing.fill(123.0f);
+        table.read_row(invalid, missing.data());
+        require(std::all_of(missing.begin(), missing.end(), [](float v) { return v == 0.0f; }),
+                "out-of-bounds converted read_row must zero the result");
+    }
+}
+
+PleIoOptions quant_options(int workers = 3) {
+    PleIoOptions io;
+    io.mode = PleIo::Mmap;
+    io.lock = true;
+    io.quantize_q8_0 = true;
+    io.quant_workers = workers;
+    return io;
+}
+
+void failures(const fs::path& source, uint64_t offset, const fs::path& q8, const fs::path& dir) {
+    std::string err;
+    const std::string path = utf8(source);
+    auto refused = [&](uint64_t at, uint64_t rows, int workers, uint32_t chunk, const char* label) {
+        err.clear();
+        auto result = open_ple_q8_0(path, at, rows, err, workers, chunk);
+        require(!result && !err.empty(), label);
+    };
+    refused(offset, kRows, 0, 127, "helper must reject zero workers");
+    refused(offset, kRows, -1, 127, "helper must reject negative workers");
+    refused(offset, kRows, 1, 0, "helper must reject zero chunk rows");
+    refused(offset, 0, 1, 127, "helper must reject empty table");
+    refused(std::numeric_limits<uint64_t>::max() - 100, kRows, 1, 127, "helper must reject overflowing offset");
+    refused(offset, std::numeric_limits<uint64_t>::max(), 1, 127, "helper must reject overflowing row extent");
+    refused(offset + 1, kRows, 1, 127, "helper must reject one-byte source overrun");
+
+    const fs::path truncated = dir / "truncated.gguf";
+    fs::copy_file(source, truncated);
+    fs::resize_file(truncated, fs::file_size(truncated) - 1);
+    err.clear();
+    require(!open_ple_q8_0(utf8(truncated), offset, kRows, err, 3, 509) && !err.empty(),
+            "helper must reject truncated final source row");
+    err.clear();
+    require(!open_ple_q8_0(utf8(dir / "absent.gguf"), offset, kRows, err, 1, 127) && !err.empty(),
+            "helper must report missing source");
+
+    PleTable table;
+    auto reject_open = [&](const fs::path& file, const PleIoOptions& io, const char* label) {
+        err.clear();
+        require(!table.open(utf8(file), err, io) && !err.empty() && !table.is_open() && !table.locked(), label);
+    };
+    auto io = quant_options();
+    io.mode = PleIo::Direct;
+    reject_open(source, io, "quantized startup must reject direct mode");
+    io = quant_options();
+    io.lock = false;
+    reject_open(source, io, "quantized startup must reject unlocked mmap");
+    reject_open(q8, quant_options(), "quantized startup must reject non-BF16 source");
+    reject_open(source, quant_options(0), "table must reject zero quant workers");
+    reject_open(source, quant_options(-1), "table must reject negative quant workers");
+    reject_open(truncated, quant_options(), "table must reject truncated BF16 source");
+    reject_open(dir / "absent.gguf", quant_options(), "table must report absent BF16 source");
+}
+} // namespace
+
+int main() {
+    try {
+        TempDir temp;
+        const fs::path bf16_path = temp.path / fs::path(u8"source-\u03bb-\u6f22.gguf");
+        const fs::path q8_path = temp.path / "oracle-q8.gguf";
+        const Oracle oracle;
+        const uint64_t offset = write_table(bf16_path, 30, oracle.source);
+        write_table(q8_path, 8, oracle.packed);
+        std::printf("ple_ram_quant_test: BF16 offset %llu, %u x %zu, %zu source bytes\n",
+                    static_cast<unsigned long long>(offset), kRows, kCols, oracle.source.size());
+
+        std::string err;
+        PleTable reader;
+        PleIoOptions ordinary;
+        ordinary.cache_rows = 0; // exercise default Direct/BF16 semantics without allocating a production cache
+        require(reader.open(utf8(q8_path), err, ordinary), "open ordinary Q8_0 reader: " + err);
+        require(std::string(reader.format()) == "Q8_0" && !reader.locked(), "ordinary Q8_0 format/lifetime");
+        std::vector<float> decoded(kRows * kCols);
+        for (uint32_t row = 0; row < kRows; ++row) reader.read_row(row, decoded.data() + row * kCols);
+        reader.close();
+
+        for (const auto [workers, chunk] : {std::pair{1, 127u}, std::pair{3, 509u}}) {
+            auto buffer = open_ple_q8_0(utf8(bf16_path), offset, kRows, err, workers, chunk);
+            require(static_cast<bool>(buffer), "CPU helper must allocate and lock small fixture: " + err);
+            exercise_partial(*buffer, oracle);
+            compare_packed(*buffer, oracle, decoded,
+                           "helper " + std::to_string(workers) + " workers / " + std::to_string(chunk) + " rows");
+        }
+        // Immediate teardown must drain reads before freeing stages/destination; later opens still work.
+        for (int generation = 0; generation < 8; ++generation) {
+            auto cancelled = open_ple_q8_0(utf8(bf16_path), offset, kRows, err, 3, 128);
+            require(static_cast<bool>(cancelled), "open before cancellation: " + err);
+            cancelled.reset();
+        }
+        failures(bf16_path, offset, q8_path, temp.path);
+
+        PleTable table;
+        for (int generation = 0; generation < 2; ++generation) {
+            require(table.open(utf8(bf16_path), err, quant_options(generation == 0 ? 1 : 3)),
+                    "open CPU-converted table: " + err);
+            require(table.is_open() && table.locked() && table.rows() == kRows &&
+                    table.mode() == PleIo::Mmap && std::string(table.format()) == "Q8_0",
+                    "converted table must expose locked Q8_0 RAM");
+            exercise_apis(table, decoded);
+            compare_all_rows(table, decoded, "converted generation " + std::to_string(generation));
+        }
+        err.clear();
+        require(!table.open(utf8(q8_path), err, quant_options()) && !err.empty() &&
+                !table.is_open() && !table.locked() && table.rows() == 0,
+                "failed reopen must release prior converted storage rather than expose stale rows");
+        require(table.open(utf8(bf16_path), err, ordinary), "reopen original BF16 after conversion: " + err);
+        require(std::string(table.format()) == "BF16" && !table.locked() && table.mode() == PleIo::Direct,
+                "ordinary reopen must discard converted storage/format");
+        compare_all_rows(table, oracle.bf16, "ordinary BF16 source remains unchanged");
+        require(table.open(utf8(q8_path), err, ordinary), "reopen ordinary Q8_0 after BF16: " + err);
+        compare_all_rows(table, decoded, "ordinary Q8_0 reopen");
+        require(table.open(utf8(bf16_path), err, quant_options()), "reopen converted table before close: " + err);
+        auto retained = open_ple_q8_0(utf8(bf16_path), offset, kRows, err, 3, 509);
+        require(static_cast<bool>(retained), "retain helper allocation: " + err);
+        require(retained->wait(err), "wait before source deletion: " + err);
+
+        const auto rows = batch_indices();
+        require(table.issue(rows.data()), "issue before close");
+        table.close();
+        require(!table.is_open() && !table.locked() && table.rows() == 0, "close must release converted table");
+        require(fs::remove(bf16_path), "completed/cancelled conversion must release source handles");
+        require(retained->ensure_row(kRows - 1, err), "completed rows survive source deletion");
+        require(retained->wait(err), "completed wait survives source deletion");
+        compare_packed(*retained, oracle, decoded, "helper after source deletion");
+        require(table.open(utf8(q8_path), err, ordinary), "reopen after closing pending conversion: " + err);
+        std::array<float, kHeads * kCols> out{};
+        require(!table.collect(out.data(), err), "reopen must not retain old pending token");
+        compare_all_rows(table, decoded, "Q8_0 after owned-buffer close");
+        std::printf("ple_ram_quant_test: PASS; exact packed and decoded CPU parity, no GPU required\n");
+        return 0;
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "ple_ram_quant_test: FAIL: %s\n", error.what());
+        return 1;
+    }
+}
diff --git a/tests/cuda/prefill_fp8_dense_test.cpp b/tests/cuda/prefill_fp8_dense_test.cpp
new file mode 100644
index 00000000..5681bfc1
--- /dev/null
+++ b/tests/cuda/prefill_fp8_dense_test.cpp
@@ -0,0 +1,634 @@
+// prefill_fp8_dense_test - the prompt path's dense projections (Y[T, N] = X[T, K] . W[N, K]^T, W in its native GGUF
+// blocks) on the FP8 tensor cores (gemm_fp8.hpp, Gemm::act8 / Gemm::native8), against
+//   - a double-precision reference: W dequantized by ggml's own to_float, times the FP32 activations, and
+//   - the FP16 path (W dequantized to FP16 in a scratch, X rounded to FP16, cuBLAS), as Gemm::native runs it.
+// Checks, per real geometry and weight type, plain and with 1-in-200 12x outliers:
+//   - the E4M3 conversion (rows of FP16 values, per-row and per-32-block power-of-two scales) against a CPU encoder,
+//     bit for bit, scales included (the block scales at their place in cuBLASLt's tiled layout);
+//   - each scale granularity cuBLASLt offers here against the reference (E4M3 keeps 3 mantissa bits: the bounds are
+//     relative RMS 6e-2, worst row 0.25), and the path the prompt runs (Gemm::native8) the same;
+//   - an all-zero row gives zeros;
+//   - width invariance: rows of the 512-row batch run again in batches of 37, 64 and 300 at shifted places give the
+//     same E4M3 rows, bit for bit, and products within 1e-5 of the max |y|; the rows whose products differ in any bit
+//     are counted, for this path and for the FP16 path, with the algorithm cuBLASLt runs for the shape;
+// --bench [T]: microseconds per product and TFLOP/s at T rows (default 32768): the FP16 path, each FP8 scale
+// granularity (conversions, the shape's algorithm, fast accumulation), the prompt path's FP8 product, and llama.cpp's
+// MMQ on Q8_0 weights for comparison.
+// --vram: the device memory the prompt path's FP8 products take on first use (cuBLASLt's lazily loaded kernels), after
+// the FP16 products of the same shapes ran.  Exit 77 without a device.
+#include "basalt/kernels/dequant_bf16.hpp"
+#include "basalt/prefill/gemm.hpp"
+#include "basalt/prefill/gemm_fp8.hpp"
+#include "basalt/prefill/moe_mmq.hpp"
+
+#include "basalt/ggml/ggml.h"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace {
+namespace fp8 = basalt::prefill::fp8;
+namespace mmq = basalt::prefill::mmq;
+using basalt::prefill::Gemm;
+
+void ck(cudaError_t e, const char* what) {
+    if (e != cudaSuccess) throw std::runtime_error(std::string(what) + ": " + cudaGetErrorString(e));
+}
