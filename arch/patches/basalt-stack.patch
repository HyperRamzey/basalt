+bool region_budget_allows(uint64_t bytes, uint64_t reserve, std::string& note) {
+    if (bytes > UINT64_MAX - reserve) {
+        note = "region size plus reserve overflows";
+        return false;
+    }
+    const uint64_t need = bytes + reserve;
+#if defined(_WIN32)
