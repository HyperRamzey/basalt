+    if (n_expert <= 0) return false;
+    for (size_t i = 0; i < res.size(); ++i)
+        if (res[i] >= 0 && res[i] >= cut && !has_copy((int64_t) i / n_expert, (int64_t) i % n_expert)) return true;
+    return false;
+}
