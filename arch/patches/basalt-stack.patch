+                    const double tf = 2.0 * (double) T * s.n * s.k / 1e6;
+                    std::printf("T %6lld %-20s Gemm %9.1f us %6.1f TFLOP/s | cublasGemmEx %9.1f us %6.1f TFLOP/s | %+6.1f%%\n",
+                                (long long) T, s.name, tn, tf / tn, to, tf / to, 100.0 * (tn / to - 1.0));
