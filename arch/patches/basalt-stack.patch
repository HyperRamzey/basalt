+    explicit Dev(size_t n) { ck(cudaMalloc(&p, std::max<size_t>(n, 256)), "cudaMalloc"); }
+    ~Dev() { cudaFree(p); }
+    Dev(const Dev&) = delete;
+    Dev& operator=(const Dev&) = delete;
+    template <typename T> T* as() const { return (T*) p; }
