+void free_home(const detail::HomeRegion& r) {
+    if (r.arena == nullptr) return;
+    if (r.registered) {
+        (void) cudaHostUnregister(r.arena);
+        basalt::platform::free_region(r.map_base, r.map_bytes);
+    } else if (r.pinned) {
+        (void) cudaFreeHost(r.arena);
+    } else {
